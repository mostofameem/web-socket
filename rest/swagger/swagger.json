{
  "openapi": "3.0.0",
  "info": {
    "title": "Active PA API",
    "description": "API for retrieving Active PA details.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3350",
      "description": "Local"
    },
    {
      "url": "https://dev.catopay.com",
      "description": "Development"
    },
    {
      "url": "http://192.168.169.58:5003",
      "description": "Staging"
    }
  ],
  "paths": {
    "/user-pulse/api/v1/active-pa/{uid}": {
      "get": {
        "summary": "Retrieve Active PA details",
        "description": "Fetch the details of an Active PA based on the provided UID.",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "description": "The unique identifier for the Active PA.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of Active PA details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "uid": {
                          "type": "string",
                          "example": "uid1"
                        },
                        "name": {
                          "type": "string",
                          "example": "Alice Smith"
                        },
                        "email": {
                          "type": "string",
                          "example": "alice.smith@example.com"
                        },
                        "devices": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "example": "abcdefgh"
                              },
                              "name": {
                                "type": "string",
                                "example": "Redmi Note 10"
                              },
                              "phoneNumbers": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "number": {
                                      "type": "string",
                                      "example": "017111111111"
                                    },
                                    "paymentMethods": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "id": {
                                            "type": "string",
                                            "example": "1"
                                          },
                                          "name": {
                                            "type": "string",
                                            "example": "bkash"
                                          },
                                          "type": {
                                            "type": "string",
                                            "example": "AGENT"
                                          },
                                          "icon": {
                                            "type": "string",
                                            "example": "bkash-icon.png"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Active PA retrieved successfully."
                    },
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error or unsuccessful retrieval.",
            "content": {
              "application/json": {
                "examples": {
                  "validationError": {
                    "summary": "Active PA not found.",
                    "value": {
                      "success": false,
                      "message": "Validation error.",
                      "errors": {
                        "uid": "This field is required"
                      }
                    }
                  },
                  "userTypeExists": {
                    "summary": "Active PA not found.",
                    "value": {
                      "success": false,
                      "message": "Unsuccessful retrieving active PA.",
                      "error": "Active PA not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user-pulse/api/v1/active-pa-list": {
      "get": {
        "summary": "Retrieve Active PA list",
        "description": "Fetch a paginated list of Active PAs based on filters like email and name.",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "description": "The page number to retrieve.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "itemsPerPage",
            "in": "query",
            "required": false,
            "description": "The number of items per page.",
            "schema": {
              "type": "integer",
              "example": 3
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": false,
            "description": "Filter by email.",
            "schema": {
              "type": "string",
              "example": "alice.smith@example.com"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Filter by name.",
            "schema": {
              "type": "string",
              "example": "Ali"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of Active PA list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Active PA list retrieved successfully."
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "uid": {
                            "type": "string",
                            "example": "1a2b3c4d5e"
                          },
                          "name": {
                            "type": "string",
                            "example": "John Doe"
                          },
                          "email": {
                            "type": "string",
                            "example": "john.doe@example.com"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unsuccessful retrieval.",
            "content": {
              "application/json": {
                "examples": {
                  "validationError": {
                    "summary": "Invalid query parameters.",
                    "value": {
                      "success": false,
                      "message": "Invalid request.",
                      "error": "Failed to bind query params"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}